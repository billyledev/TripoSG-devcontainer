{
  "name": "tensorflow-dev-container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--gpus",
    "all"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode,type=bind",
  "workspaceFolder": "/home/vscode",
  "mounts": [
    "source=${localEnv:HOME}/Documents/AI/Models,target=/home/vscode/TripoSG/pretrained_weights,type=bind,readonly"
  ]
}